# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Application Details
PROJECT_NAME="Secure Centralized Blood Bank Management System"
API_V1_PREFIX=/api

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=secure_blood_bank
MONGODB_TIMEOUT_MS=5000

# Security - JWT
JWT_SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_HEX_32_BYTES_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Security - AES-256-GCM Sensitive Field Encryption (32-byte base64 encoded)
ENCRYPTION_SECRET_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY

# Security - Argon2id parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
